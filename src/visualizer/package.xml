<?xml version="1.0"?>
<package format="2">
  <name>visualizer</name>
  <version>0.0.1</version>
  <description>Independent node_pipeline renderers for map, vehicle, paths and objects.</description>
  <maintainer email="dev@team-stier.local">Team Stier</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>qtbase5-dev</build_depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>interfaces</depend>
  <depend>node_pipeline</depend>
  <depend>boost</depend>
  <depend>pugixml-dev</depend>
  <depend>morai_msgs</depend>
  <depend>lanelet2_core</depend>
  <depend>lanelet2_io</depend>
  <depend>tf2_ros</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>rviz</depend>
  <depend>pluginlib</depend>
  <exec_depend>tf</exec_depend>
  <depend>std_msgs</depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <export>
    <rviz plugin="${prefix}/rviz_plugins.xml"/>
  </export>
</package>
