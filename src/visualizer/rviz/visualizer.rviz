Panels:
- Class: rviz/Displays
  Name: Displays
- Class: rviz/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 25; 25; 25
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz/Marker
    Name: K-City map
    Enabled: true
    Marker Topic: /visualizer/map
    Queue Size: 1
  - Class: rviz/MarkerArray
    Name: Checkpoints S1-S16
    Enabled: true
    Marker Topic: /visualizer/checkpoints
    Queue Size: 1
  - Class: rviz/Marker
    Name: Local path (orange)
    Enabled: true
    Marker Topic: /visualizer/local_path
    Queue Size: 1
  - Class: rviz/Marker
    Name: Obstacles - static blue, dynamic red, unknown yellow
    Enabled: true
    Marker Topic: /visualizer/object_motion
    Queue Size: 1
  - Class: rviz/Marker
    Name: Detected object boxes
    Enabled: true
    Marker Topic: /visualizer/objects
    Queue Size: 1
  - Class: rviz/MarkerArray
    Name: Object ID speed and size
    Enabled: true
    Marker Topic: /visualizer/object_details
    Queue Size: 1
  - Class: visualizer/TrafficSignalOverlay
    Name: Traffic light state (top right)
    Enabled: true
  - Class: visualizer/TrafficSignalOverlay
    Name: E-stop state (under the traffic light)
    Enabled: true
    Topic: /visualizer/estop
    Top: 48
  - Class: rviz/RobotModel
    Name: IONIQ 5 body and wheels
    Enabled: true
    Robot Description: /visualizer/robot_description
    Visual Enabled: true
    Collision Enabled: false
    TF Prefix: ''
    Update Interval: 0
    Alpha: 0.85
  - Class: rviz/Odometry
    Name: Vehicle position and heading
    Enabled: true
    Topic: /localization/ego
    Keep: 1
    Shape: Arrow
    Color: 255; 170; 0
    Position Tolerance: 0
    Angle Tolerance: 0
    Shaft Length: 2
    Shaft Radius: 0.05
    Head Length: 0.5
    Head Radius: 0.15
  - Class: rviz/PointCloud2
    Name: Leveled LiDAR
    Enabled: true
    Topic: /velodyne_points/leveled
    Queue Size: 1
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 2
    Size (m): 0.02
    Color Transformer: FlatColor
    Color: 120; 220; 150
    Alpha: 0.65
    Decay Time: 0
    Use Fixed Frame: true
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Vehicle follow
      Target Frame: base_link
      Scale: 20
      Angle: -1.5708
      X: 0
      Y: 0
    Saved:
    - Class: rviz/TopDownOrtho
      Name: Whole map
      Target Frame: map
      Scale: 0.7
      Angle: 0
      X: 180
      Y: -80
Window Geometry:
  Width: 1600
  Height: 950
