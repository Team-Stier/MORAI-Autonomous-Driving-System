# e2e_driver runtime settings, read by run.sh. After submission only the IP/port settings may change (rules), which
# live in the bridge config named here; the model paths below are fixed with the submitted PC.

# Model server (Python 3.12 venv: src/e2e_driver/tools/setup_server_env.sh). Empty E2E_MODEL_PYTHON: run.sh does not
# start it and an external server must listen on 127.0.0.1:47011 (winpc: the stack runs in a Noetic chroot, the
# server outside it, tools/winpc/server.sh).
E2E_MODEL_PYTHON=
E2E_MODEL_BACKEND=engine                     # engine (5080 NVFP4/FP8) | hf | fake
E2E_MODEL_CKPT=                              # engine: the QAD deliver dir (swap in a new delivery here); hf: a checkpoint dir
E2E_MODEL_VLM=Qwen/Qwen3-VL-4B-Instruct      # base VLM: HF id (offline cache in HF_HOME) or a local dir
E2E_MODEL_ARGS=                              # extra model_server.py arguments, e.g. --steps 10
HF_HOME=                                     # HF cache holding the base VLM (empty: ~/.cache/huggingface)

# Simulator clock tau (/clock + use_sim_time): MORAI runs below real time and sends no simulation time.
E2E_SIM_CLOCK=1

# Bridge: UDP ports, simulator and bridge IPs (the settings changeable after submission).
MORAI_BRIDGE_CONFIG=src/e2e_driver/config/bridge_same_pc.yaml
