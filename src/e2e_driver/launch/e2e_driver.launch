<launch>
  <!-- the model server (server/model_server.py) runs outside the ROS chroot, on the GPU; see README -->
  <node pkg="e2e_driver" type="e2e_driver_node.py" name="e2e_driver" output="screen" respawn="true" respawn_delay="1.0">
    <rosparam command="load" file="$(find e2e_driver)/config/e2e_driver.yaml"/>
    <param name="route_asset" value="$(find e2e_driver)/assets/route.json"/>
    <!-- load tests with the fake backend only: route-following curvature (pure pursuit, this many metres ahead) -->
    <param name="fake_follow_route_m" value="$(optenv E2E_FAKE_FOLLOW_ROUTE_M 0)"/>
    <!-- several stacks on one host (tools/pod/stacks.sh): a model server port per stack; unset = the yaml's -->
    <param if="$(eval optenv('E2E_SERVER_PORT', '') != '')" name="server_port" value="$(optenv E2E_SERVER_PORT 0)" type="int"/>
    <!-- evaluation below real time (tools/pod/eval3.sh: 0.1): plans drive from t0 + this on tau; unset = the yaml's -->
    <param if="$(eval optenv('E2E_APPLY_DELAY_S', '') != '')" name="apply_delay_s" value="$(optenv E2E_APPLY_DELAY_S 0)" type="double"/>
    <!-- the world number the node puts in its requests (RL episode managers pick their decisions from the engine dumps) -->
    <param name="world" value="$(optenv E2E_WORLD 0)" type="int"/>
  </node>
</launch>
