<?xml version="1.0"?>
<package format="2">
  <name>e2e_driver</name>
  <version>0.1.0</version>
  <description>Closed-loop evaluation node for the distilled E2E student (WoWmayo): MORAI sensors -> model server -> /control_cmd.</description>
  <maintainer email="dev@team-stier.local">Team Stier</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>interfaces</depend>
  <depend>morai_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
</package>
