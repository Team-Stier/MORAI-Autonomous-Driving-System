+  // DAgger shadow (10/28): the collection driver changed lanes late, 8-16 m long at any speed (a 3.5 m shift at 23 m/s
+  // is curvature ~0.08, so velocity_planner's curve speed sqrt(2.6 / 0.08) dropped it to ~5.7 m/s) and blind to the
+  // moving cars (gt-objects-filter drops them; shadow_objects.py adds the highway's moving vehicles in map axes). A
+  // change now waits for a gap in the target lane: a car behind within REAR_RANGE_M (what the model's LiDAR BEV sees:
+  // 20 m back) at least GAP_M away and GAP_REAR_TTC_S from closing in, one ahead within FRONT_RANGE_M at least GAP_M
+  // and GAP_FRONT_TTC_S; and a lane that ends (a merge lane) is driven to a stop short of its end until then.
+  static constexpr double LANE_CHANGE_S = 3.0, GAP_M = 10.0, GAP_REAR_TTC_S = 3.0, GAP_FRONT_TTC_S = 2.0;
+  static constexpr double REAR_RANGE_M = 20.0, FRONT_RANGE_M = 80.0, LANE_HALF_M = 2.0, END_DECEL = 2.0, END_GAP_M = 2.0;
+  // a lane change's path runs LANE_CHANGE_EXTRA_M past path_length_m (3 s at 27 m/s); the others keep 50 m, so the
+  // stop-line cutoff (velocity_planner, on the path's length) still starts 50 m out
+  static constexpr double LANE_CHANGE_EXTRA_M = 30.0;
+  struct Mover { Vec2 center; double half_length; Vec2 velocity; };
+  std::vector<Mover> movingVehicles(const interfaces::Objects& objects) const {
+    std::vector<Mover> movers;
+    for (const auto& object : objects.objects) {
+      const Vec2 v(object.velocity.x, object.velocity.y);
+      if (object.label == "vehicle" && object.velocity_available && v.norm() >= 0.3)
+        movers.push_back({xy(object.bbox_pose.position), object.bbox_size.x / 2, v});
+    }
+    return movers;
   }
+  bool gapOk(const Reference& reference, const std::vector<Mover>& movers, const Vec2& position, double speed) const {
+    for (const auto& m : movers) {
+      const auto p = project(reference.line, m.center);
+      if (p.distance_squared > LANE_HALF_M * LANE_HALF_M) continue;   // not in the target lane
+      const double rel = p.station - reference.start_s;
+      const double along = m.velocity.dot(unit(p.heading));
+      if (rel < 0) {
+        if (-rel > REAR_RANGE_M + m.half_length) continue;
+        const double gap = -rel - parameters_.vehicle_rear_m - m.half_length, closing = along - speed;
+        if (gap < GAP_M || (closing > 0 && gap / closing < GAP_REAR_TTC_S)) return false;
+      } else {
+        const double gap = rel - parameters_.vehicle_front_m - m.half_length, closing = speed - along;
+        if (gap > FRONT_RANGE_M) continue;
+        if (gap < GAP_M || (closing > 0 && gap / closing < GAP_FRONT_TTC_S)) return false;
+      }
+    }
+    return true;
+  }
+  static void stopAtLaneEnd(interfaces::Path& path, double end) {
+    double station = 0.0;
+    for (std::size_t i = 0; i < path.points.size(); ++i) {
+      if (i) station += (xy(path.points[i].pose.pose.position) - xy(path.points[i - 1].pose.pose.position)).norm();
+      const double v = std::sqrt(std::max(0.0, 2.0 * END_DECEL * (end - END_GAP_M - station)));
+      if (v < 16.0) path.points[i].velocity = v;          // the rest keeps velocity_planner's target (NaN)
+    }
+  }
