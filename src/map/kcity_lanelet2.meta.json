      "easting_m": 302595.0,
      "northing_m": 4124145.0
    },
    "axes": {
      "x": "UTM grid east",
      "y": "UTM grid north",
      "z": "up"
    },
    "vertical_datum": null,
    "transform": {
      "x": "UTM_E - 302595.0",
      "y": "UTM_N - 4124145.0",
      "z": "Preserve elevation in metres; vertical datum is unspecified."
    }
  }
}
