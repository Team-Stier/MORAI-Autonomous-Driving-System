<?xml version="1.0"?>
<package format="2">
  <name>control</name><version>0.1.0</version>
  <description>Path tracking control core with ROS pipeline input policy.</description>
  <maintainer email="dev@team-stier.local">Team Stier</maintainer>
  <license>MIT</license><buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>interfaces</depend>
  <depend>morai_msgs</depend>
  <depend>node_pipeline</depend>
  <depend>roscpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>boost</depend>
  <depend>fmt</depend>
  <depend>osqp_vendor</depend>
  <depend>qpoases_vendor</depend>
  <export><node_pipeline include_roots="osqp.h fmt experimental qpOASES"/></export>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>gtest</test_depend>
  <test_depend>python3-nose</test_depend>
</package>
