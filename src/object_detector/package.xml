<?xml version="1.0"?>
<package format="2">
  <name>object_detector</name><version>0.1.0</version>
  <description>Core-free ROS pipeline connections for object_detector.</description>
  <maintainer email="dev@team-stier.local">Team Stier</maintainer>
  <license>MIT</license><buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>interfaces</depend>
  <depend>tf2_msgs</depend>
  <depend>node_pipeline</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libflann-dev</depend>
  <depend>eigen</depend>
  <depend>lanelet2_core</depend>
  <depend>lanelet2_io</depend>
  <depend>lanelet2_routing</depend>
  <depend>lanelet2_traffic_rules</depend>
  <depend>pugixml-dev</depend>
  <export><node_pipeline include_roots="pcl flann"/></export>
</package>
